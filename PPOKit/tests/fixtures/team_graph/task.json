{
  "schema": "ppokit.task/1",
  "name": "team_graph",
  "namespace": "ppokit::tests::team_graph",
  "agents": { "min": 1, "max": 3 },
  "observation": {
    "line": { "fields": ["offset", "elapsed"] }
  },
  "critic": {
    "own": { "size": 4 },
    "team_mean": { "size": 4 },
    "team_max": { "size": 4 },
    "living_fraction": { "size": 1 },
    "team_fraction": { "size": 1 }
  },
  "actions": {
    "move": { "head": "gaussian", "names": ["velocity"], "bounds": [-1, 1], "map": "clip" }
  },
  "rewards": {
    "Progress": { "label": "Distance gained" }
  }
}
