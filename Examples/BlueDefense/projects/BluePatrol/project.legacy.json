{
  "schema": "ppokit.project/1",
  "name": "BluePatrol",
  "program": {
    "executable": "ppokit-run",
    "train": [
      "train",
      "--project",
      "{project}",
      "--until-update",
      "4000"
    ],
    "evaluate": [
      "eval",
      "--project",
      "{project}",
      "--policy",
      "checkpoints/prod/policy.ppokit"
    ],
    "inference": [
      "play",
      "--project",
      "{project}",
      "--policy",
      "checkpoints/prod/policy.ppokit",
      "--episodes",
      "1000000",
      "--realtime",
      "--step-seconds",
      "0.004"
    ]
  },
  "learnerSettings": "blue_patrol_training.json",
  "settings": "scenario.json",
  "externalCurriculum": "../../../../tools/ci/adaptive_curriculum/gates.json",
  "externalCurriculumProgress": "checkpoints/adaptive-curriculum-progress.json",
  "networkEditable": false,
  "journal": "checkpoints/latest/metrics.jsonl",
  "libraries": {
    "environment": "blue_environment",
    "network": "blue_network"
  },
  "checkpoints": {
    "training": "checkpoints/latest/latest.ppokit",
    "policy": "checkpoints/latest/policy.ppokit"
  }
}
