{
  "schema": "ppokit.task/1",
  "name": "flight_control_3d",
  "namespace": "ppo::examples::flight::task",
  "agents": { "min": 1, "max": 1 },
  "observation": {
    "runway": { "fields": ["along", "cross", "height", "glide_path_error", "runway_remaining"] },
    "velocity": { "fields": ["velocity_forward", "velocity_right", "velocity_up", "airspeed_error", "vertical_speed_error"] },
    "attitude": { "fields": ["roll_sin", "roll_cos", "pitch_sin", "heading_sin", "heading_cos", "roll_rate", "pitch_rate", "yaw_rate"] },
    "directions": { "fields": [
      "target_direction_body_forward", "target_direction_body_right", "target_direction_body_up",
      "velocity_direction_body_forward", "velocity_direction_body_right", "velocity_direction_body_up"] },
    "phase": { "fields": ["weight_on_wheels", "rollout", "stop_progress", "elapsed", "gear_position", "gear_commanded"] },
    "controls": { "fields": ["filtered_elevator", "filtered_aileron", "filtered_rudder", "filtered_throttle", "filtered_brake"] }
  },
  "actions": {
    "controls": {
      "head": "gaussian",
      "names": ["elevator", "aileron", "rudder", "throttle", "brake"],
      "bounds": [-1, 1],
      "map": "clip",
      "active": { "brake": { "when": "rollout", "above": 0.5 } }
    },
    "gear": { "head": "bernoulli", "on_zero": true, "names": ["gear"], "active": { "gear": { "when": "gear_commanded", "at_most": 0.5 } } }
  },
  "rewards": {
    "Path": {},
    "Direction": {},
    "VerticalSpeed": { "label": "Vertical speed" },
    "Speed": {},
    "Touchdown": {},
    "Stop": {},
    "Crash": {}
  },
  "metrics": {
    "stopped": { "kind": "flag", "label": "Stopped on the runway" },
    "touched_down": { "kind": "flag", "label": "Touched down" },
    "crashed": { "kind": "flag", "label": "Crashed" },
    "timed_out": { "kind": "flag", "label": "Timed out" },
    "stop_m": { "kind": "number", "label": "Stop past the threshold", "unit": "m" },
    "touchdown_m": { "kind": "number", "label": "Touchdown past the threshold", "unit": "m" },
    "difficulty": { "kind": "number", "label": "Curriculum difficulty of the campaign" }
  }
}
