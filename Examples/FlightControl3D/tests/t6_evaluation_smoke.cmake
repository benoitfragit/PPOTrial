# ppokit-run evaluates projects/T6 (environment and network DLLs) on a copy: master's BEST
# record of the same checkpoint (update 870): 19 stops of 20, mean stop distance 546.87 m.
# The T-6 policy copied into the PC-7 project by mistake is refused (another aircraft).
# Arguments: RUN (ppokit-run), PROJECT (projects/T6), PC7 (projects/PC7), WORK (scratch folder).
file(REMOVE_RECURSE "${WORK}")
file(COPY "${PROJECT}/" DESTINATION "${WORK}")
execute_process(COMMAND "${RUN}" eval --model LATEST --project "${WORK}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if (NOT result EQUAL 0 OR NOT output MATCHES "20 episodes, passed")
    message(FATAL_ERROR "ppokit-run eval T6 failed (${result}):\n${output}\n${errors}")
endif()
file(READ "${WORK}/checkpoints/evaluation_validation.json" report)
string(JSON stopped GET "${report}" aggregates stopped.rate)
string(JSON stop GET "${report}" aggregates stop_m.mean)
string(FIND "${stop}" "546.87" at)
if (NOT stopped EQUAL 0.95 OR NOT at EQUAL 0)
    message(FATAL_ERROR "T6: stopped.rate ${stopped}, stop_m.mean ${stop}; master's record: 0.95, 546.87...")
endif()
message(STATUS "T6: stopped.rate ${stopped}, stop_m.mean ${stop}")
# Even an early training frontier must play the historical full-task inference mix.
file(WRITE "${WORK}/checkpoints/ppokit_curriculum_level.txt" "0\n")
execute_process(COMMAND "${RUN}" play --model LATEST --project "${WORK}"
    RESULT_VARIABLE result OUTPUT_VARIABLE played ERROR_VARIABLE errors)
if (NOT result EQUAL 0 OR NOT played MATCHES "mean return over 20 episodes")
    message(FATAL_ERROR "native inference campaign failed (${result}): ${errors}\n${played}")
endif()
foreach(i RANGE 0 19)
    string(JSON steps GET "${report}" episodes ${i} length)
    string(JSON terminal GET "${report}" episodes ${i} terminated)
    if(terminal)
        set(ending terminated)
    else()
        set(ending truncated)
    endif()
    math(EXPR episode "${i} + 1")
    if(NOT played MATCHES "episode ${episode}: return [^,]+, ${steps} steps, ${ending}")
        message(FATAL_ERROR "inference diverged at episode ${episode}: expected ${steps} steps, ${ending}")
    endif()
endforeach()

# The scenario is authoritative unless the command supplies an override.
file(READ "${WORK}/scenario.json" scenario)
string(JSON scenario SET "${scenario}" training maxUpdates 870)
string(JSON scenario SET "${scenario}" training checkpointEvery 3)
string(JSON scenario SET "${scenario}" training randomizeEnvironmentSeed false)
file(WRITE "${WORK}/scenario.json" "${scenario}")
execute_process(COMMAND "${RUN}" train --resume --project "${WORK}"
    RESULT_VARIABLE result OUTPUT_VARIABLE trained ERROR_VARIABLE errors)
if(NOT result EQUAL 0 OR NOT trained MATCHES "checkpoint every 3, budget absolute"
    OR NOT trained MATCHES "up to update 870" OR trained MATCHES "update 871/")
    message(FATAL_ERROR "training ignored its native run profile (${result}): ${errors}\n${trained}")
endif()
file(REMOVE_RECURSE "${WORK}")

file(COPY "${PC7}/" DESTINATION "${WORK}")
file(COPY "${PROJECT}/checkpoints/policy.ppokit" DESTINATION "${WORK}/checkpoints")
execute_process(COMMAND "${RUN}" eval --model LATEST --project "${WORK}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if (result EQUAL 0 OR NOT errors MATCHES "trained in the environment 't6texan2@8-centreline1200', this project's is 'pc7@8-centreline1200'")
    message(FATAL_ERROR "the PC-7 project did not refuse the T-6 policy (${result}):\n${output}\n${errors}")
endif()
# The actual desktop defaults must work in a fresh checkout for both aircraft.
foreach(aircraft IN ITEMS T6 PC7)
    set(folder "${WORK}/catalog_${aircraft}")
    if(aircraft STREQUAL "T6")
        file(COPY "${PROJECT}/" DESTINATION "${folder}")
        set(expected_update 870)
    else()
        file(COPY "${PC7}/" DESTINATION "${folder}")
        set(expected_update 610)
    endif()
    execute_process(COMMAND "${RUN}" eval --project "${folder}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${aircraft} packaged BEST unavailable: ${errors}\n${output}")
    endif()
    file(READ "${folder}/checkpoints/evaluation_validation.json" catalog_report)
    string(JSON role GET "${catalog_report}" policy_role)
    string(JSON update GET "${catalog_report}" update)
    string(JSON stops GET "${catalog_report}" aggregates stopped.rate)
    string(JSON path GET "${catalog_report}" policy_file)
    string(JSON digest GET "${catalog_report}" policy_sha256)
    file(SHA256 "${path}" actual)
    if(NOT role STREQUAL "HISTORICAL_BEST" OR NOT update EQUAL expected_update OR NOT stops EQUAL 0.95 OR NOT actual STREQUAL digest)
        message(FATAL_ERROR "${aircraft} selected the wrong actor or changed its historical score: ${role} ${update} ${stops}")
    endif()
endforeach()
file(REMOVE_RECURSE "${WORK}")
