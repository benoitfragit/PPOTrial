{
  "schema": "ppokit.task/1",
  "name": "flight_control_3d",
  "contract": "t6texan2@8-centreline1200",
  "namespace": "ppo::examples::flight::task",
  "agents": { "min": 1, "max": 1 },
  "observation": {
    "runway": { "fields": ["along", "cross", "height", "glide_path_error", "runway_remaining"] },
    "velocity": { "fields": ["velocity_forward", "velocity_right", "velocity_up", "airspeed_error", "vertical_speed_error"] },
    "attitude": { "fields": ["roll_sin", "roll_cos", "pitch_sin", "heading_sin", "heading_cos", "roll_rate", "pitch_rate", "yaw_rate"] },
    "directions": { "fields": [
      "target_direction_body_forward", "target_direction_body_right", "target_direction_body_up",
      "velocity_direction_body_forward", "velocity_direction_body_right", "velocity_direction_body_up"] },
    "phase": { "fields": ["weight_on_wheels", "rollout", "stop_progress", "elapsed", "gear_position", "gear_commanded"] },
    "controls": { "fields": ["filtered_elevator", "filtered_aileron", "filtered_rudder", "filtered_throttle", "filtered_brake"] }
  },
  "actions": {
    "controls": {
      "head": "gaussian",
      "names": ["elevator", "aileron", "rudder", "throttle", "brake"],
      "bounds": [-1, 1],
      "map": "clip",
      "active": { "brake": { "when": "rollout", "above": 0.5 } }
    },
    "gear": { "head": "bernoulli", "on_zero": true, "names": ["gear"], "active": { "gear": { "when": "gear_commanded", "at_most": 0.5 } } }
  },
  "world": {
    "aircraft": { "fields": ["aircraft_north", "aircraft_east", "aircraft_up", "aircraft_roll", "aircraft_pitch",
                             "aircraft_heading", "aircraft_gear", "aircraft_airspeed"] },
    "airfield": { "fields": ["runway_north", "runway_east", "runway_up", "runway_heading", "runway_length",
                             "runway_width"] },
    "deck": { "fields": ["threshold_height", "landing_margin", "elevation", "sea_height", "deck_speed",
                         "deck_vertical_speed", "swell_amplitude", "swell_period", "heave", "swell_angle"] },
    "guidance": { "fields": ["guidance_mode", "target_valid", "target_speed", "target_slope", "target_heading",
                             "target_north", "target_east", "target_up", "direction_north", "direction_east",
                             "direction_up", "velocity_direction_north", "velocity_direction_east",
                             "velocity_direction_up", "relative_along", "relative_right", "relative_up",
                             "guidance_along", "guidance_cross", "guidance_distance", "guidance_height", "aim_along",
                             "glide_degrees"] },
    "mission": { "fields": ["mission_phase", "mission_outcome", "elapsed_seconds", "maximum_seconds", "last_outcome",
                            "last_seconds", "weight_on_wheels_now", "aircraft_type", "run_mode", "started_airborne",
                            "curriculum_level", "curriculum_levels", "window_stops", "window_episodes",
                            "curriculum_difficulty", "applied_elevator", "applied_aileron", "applied_rudder",
                            "applied_throttle", "applied_brake", "applied_flap", "applied_gear",
                            "episodes_finished", "touchdowns", "stops", "crashes", "timeouts"] },
    "landing": { "fields": ["landing_from_current", "landing_touched_down", "touchdown_from_threshold",
                            "ground_roll", "touchdown_sink", "touchdown_speed", "touchdown_quality",
                            "landing_area_factor", "landing_outcome", "stop_from_threshold"] },
    "crash": { "fields": ["crash", "crash_event", "invalid_state_failed", "invalid_state_value",
                          "invalid_state_limit", "distance_failed", "distance_value", "distance_limit",
                          "altitude_failed", "altitude_value", "altitude_limit", "landing_area_failed",
                          "landing_area_value", "landing_area_limit", "wheels_outside_failed",
                          "wheels_outside_value", "wheels_outside_limit", "gear_failed", "gear_value", "gear_limit",
                          "structural_contact_failed", "structural_contact_value", "structural_contact_limit",
                          "sink_failed", "sink_value", "sink_limit", "speed_failed", "speed_value", "speed_limit",
                          "roll_failed", "roll_value", "roll_limit", "pitch_low_failed", "pitch_low_value",
                          "pitch_low_limit", "pitch_high_failed", "pitch_high_value", "pitch_high_limit",
                          "heading_failed", "heading_value", "heading_limit", "no_wheel_contact_failed",
                          "no_wheel_contact_value", "no_wheel_contact_limit", "route_incomplete_failed",
                          "route_incomplete_value", "route_incomplete_limit", "crash_aircraft_north",
                          "crash_aircraft_east", "crash_aircraft_up", "crash_aircraft_roll", "crash_aircraft_pitch",
                          "crash_aircraft_heading", "crash_aircraft_gear", "crash_runway_north", "crash_runway_east",
                          "crash_runway_up", "crash_runway_heading"] },
    "episode_rewards": { "fields": ["episode_Path", "episode_Direction", "episode_VerticalSpeed", "episode_Speed",
                                    "episode_Touchdown", "episode_Stop", "episode_Crash", "weight_Path",
                                    "weight_Direction", "weight_VerticalSpeed", "weight_Speed", "weight_Touchdown",
                                    "weight_Stop", "weight_Crash"] },
    "diagnostics": { "fields": ["diagnostics_enabled", "saturation_threshold", "window_samples",
                                "live_observation_0", "live_observation_1", "live_observation_2",
                                "live_observation_3", "live_observation_4", "live_observation_5",
                                "live_observation_6", "live_observation_7", "live_observation_8",
                                "live_observation_9", "live_observation_10", "live_observation_11",
                                "live_observation_12", "live_observation_13", "live_observation_14",
                                "live_observation_15", "live_observation_16", "live_observation_17",
                                "live_observation_18", "live_observation_19", "live_observation_20",
                                "live_observation_21", "live_observation_22", "live_observation_23",
                                "live_observation_24", "live_observation_25", "live_observation_26",
                                "live_observation_27", "live_observation_28", "live_observation_29",
                                "live_observation_30", "live_observation_31", "live_observation_32",
                                "live_observation_33", "live_observation_34", "live_raw_elevator",
                                "live_raw_aileron", "live_raw_rudder", "live_raw_throttle", "live_raw_brake",
                                "observation_mean_abs_0", "observation_mean_abs_1", "observation_mean_abs_2",
                                "observation_mean_abs_3", "observation_mean_abs_4", "observation_mean_abs_5",
                                "observation_mean_abs_6", "observation_mean_abs_7", "observation_mean_abs_8",
                                "observation_mean_abs_9", "observation_mean_abs_10", "observation_mean_abs_11",
                                "observation_mean_abs_12", "observation_mean_abs_13", "observation_mean_abs_14",
                                "observation_mean_abs_15", "observation_mean_abs_16", "observation_mean_abs_17",
                                "observation_mean_abs_18", "observation_mean_abs_19", "observation_mean_abs_20",
                                "observation_mean_abs_21", "observation_mean_abs_22", "observation_mean_abs_23",
                                "observation_mean_abs_24", "observation_mean_abs_25", "observation_mean_abs_26",
                                "observation_mean_abs_27", "observation_mean_abs_28", "observation_mean_abs_29",
                                "observation_mean_abs_30", "observation_mean_abs_31", "observation_mean_abs_32",
                                "observation_mean_abs_33", "observation_mean_abs_34", "observation_max_abs_0",
                                "observation_max_abs_1", "observation_max_abs_2", "observation_max_abs_3",
                                "observation_max_abs_4", "observation_max_abs_5", "observation_max_abs_6",
                                "observation_max_abs_7", "observation_max_abs_8", "observation_max_abs_9",
                                "observation_max_abs_10", "observation_max_abs_11", "observation_max_abs_12",
                                "observation_max_abs_13", "observation_max_abs_14", "observation_max_abs_15",
                                "observation_max_abs_16", "observation_max_abs_17", "observation_max_abs_18",
                                "observation_max_abs_19", "observation_max_abs_20", "observation_max_abs_21",
                                "observation_max_abs_22", "observation_max_abs_23", "observation_max_abs_24",
                                "observation_max_abs_25", "observation_max_abs_26", "observation_max_abs_27",
                                "observation_max_abs_28", "observation_max_abs_29", "observation_max_abs_30",
                                "observation_max_abs_31", "observation_max_abs_32", "observation_max_abs_33",
                                "observation_max_abs_34", "observation_saturations_0", "observation_saturations_1",
                                "observation_saturations_2", "observation_saturations_3",
                                "observation_saturations_4", "observation_saturations_5",
                                "observation_saturations_6", "observation_saturations_7",
                                "observation_saturations_8", "observation_saturations_9",
                                "observation_saturations_10", "observation_saturations_11",
                                "observation_saturations_12", "observation_saturations_13",
                                "observation_saturations_14", "observation_saturations_15",
                                "observation_saturations_16", "observation_saturations_17",
                                "observation_saturations_18", "observation_saturations_19",
                                "observation_saturations_20", "observation_saturations_21",
                                "observation_saturations_22", "observation_saturations_23",
                                "observation_saturations_24", "observation_saturations_25",
                                "observation_saturations_26", "observation_saturations_27",
                                "observation_saturations_28", "observation_saturations_29",
                                "observation_saturations_30", "observation_saturations_31",
                                "observation_saturations_32", "observation_saturations_33",
                                "observation_saturations_34", "raw_mean_abs_elevator", "raw_mean_abs_aileron",
                                "raw_mean_abs_rudder", "raw_mean_abs_throttle", "raw_mean_abs_brake",
                                "applied_mean_abs_elevator", "applied_mean_abs_aileron", "applied_mean_abs_rudder",
                                "applied_mean_abs_throttle", "applied_mean_abs_brake", "raw_saturations_elevator",
                                "raw_saturations_aileron", "raw_saturations_rudder", "raw_saturations_throttle",
                                "raw_saturations_brake", "applied_saturations_elevator",
                                "applied_saturations_aileron", "applied_saturations_rudder",
                                "applied_saturations_throttle", "applied_saturations_brake", "reward_mean_Path",
                                "reward_mean_Direction", "reward_mean_VerticalSpeed", "reward_mean_Speed",
                                "reward_mean_Touchdown", "reward_mean_Stop", "reward_mean_Crash"] }
  },
  "rewards": {
    "Path": {},
    "Direction": {},
    "VerticalSpeed": { "label": "Vertical speed" },
    "Speed": {},
    "Touchdown": {},
    "Stop": {},
    "Crash": {}
  },
  "metrics": {
    "stopped": { "kind": "flag", "label": "Stopped on the runway" },
    "touched_down": { "kind": "flag", "label": "Touched down" },
    "crashed": { "kind": "flag", "label": "Crashed" },
    "timed_out": { "kind": "flag", "label": "Timed out" },
    "stop_m": { "kind": "number", "label": "Stop past the threshold", "unit": "m" },
    "touchdown_m": { "kind": "number", "label": "Touchdown past the threshold", "unit": "m" },
    "difficulty": { "kind": "number", "label": "Curriculum difficulty of the campaign" }
  }
}
